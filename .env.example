PORT=3456
HOST=0.0.0.0
DATA_DIR=./data
PLAYA_PASSWORD=your_secret_vault_password_here

# DigitalOcean Spaces Credentials
SPACES_KEY=your_spaces_key_here
SPACES_SECRET=your_spaces_secret_here
SPACES_BUCKET=playa
SPACES_REGION=syd1
SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
SPACES_CDN_URL=https://playa.syd1.cdn.digitaloceanspaces.com

# Library Directories (on your Linux machine for uploading & scanning)
# Point MUSIC_DIR to the mount root so it automatically scans across all dated batch folders (e.g. 20261028/, 20261029/)
MUSIC_DIR=/home/bobohilife/spaces_mount
LOCAL_MOUNT_DIR=/home/bobohilife/spaces_mount
