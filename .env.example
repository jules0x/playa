# Playa Environment Configuration

# Server
PORT=3456
HOST=0.0.0.0
DATA_DIR=./data

# DigitalOcean Spaces (S3) Configuration
# Leave blank if running against a local directory
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=my-music-vault
DO_SPACES_REGION=us-east-1

# Local test directory (used when not using Spaces)
MUSIC_DIR=./sample_music
